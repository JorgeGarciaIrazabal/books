{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "ollama": {
      "models": {
        "kimi-k3:cloud": {
          "variants": [
            {
              "id": "low",
              "body": {
                "reasoning_effort": "low"
              }
            },
            {
              "id": "high",
              "body": {
                "reasoning_effort": "high"
              }
            },
            {
              "id": "max",
              "body": {
                "reasoning_effort": "max"
              }
            }
          ]
        },
        "mistral-large-4:cloud": {
          "variants": [
            {
              "id": "none",
              "body": {
                "reasoning_effort": "none"
              }
            },
            {
              "id": "high",
              "body": {
                "reasoning_effort": "high"
              }
            }
          ]
        }
      }
    }
  },
  "agents": {
    "ab_candidate": {
      "mode": "primary",
      "steps": 2,
      "system": "Complete the attached bounded writing assignment. Do not use tools or delegate. Return only the requested artifacts, without process commentary or model identity.",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "ab_judge": {
      "mode": "primary",
      "steps": 2,
      "system": "Review the attached anonymous literary pairs independently. No tools, outside files, delegation or author guessing. Return only the requested JSON.",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  }
}
